<?xml version="1.0"?>
<package format="3">
  <name>mycobot_280_gazebo_jazzy</name>
  <version>0.1.0</version>
  <description>Minimal Gazebo simulation for MyCobot 280 on ROS2 Jazzy</description>

  <maintainer email="you@example.com">You</maintainer>
  <license>MIT</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Meshes live here -->
  <exec_depend>mycobot_description</exec_depend>

  <!-- Gazebo Harmonic for Jazzy -->
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>ros_gz</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <!-- ros2_control stack -->
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>

  <!-- Essential nodes -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>